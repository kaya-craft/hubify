{
  "name": "@hubify/app",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./nuxt.config.ts",
    "./modules/*": "./modules/*.ts",
    "./schema/*": "./schema/*.ts",
    "./types/*": "./types/*.d.ts",
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/*.ts",
      "default": "./lib/*/index.ts"
    }
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.5",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@hubify/api": "workspace:*",
    "@hubify/vue-language-plugins": "workspace:*",
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/lucide": "^1.2.66",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.50",
    "@internationalized/date": "^3.9.0",
    "@nuxt/ui": "^3.3.3",
    "@nuxt/ui-pro": "catalog:",
    "@nuxtjs/i18n": "^10.0.6",
    "@vueuse/core": "^13.9.0",
    "@vueuse/integrations": "^13.9.0",
    "@vueuse/nuxt": "^13.9.0",
    "@vueuse/router": "14.0.0",
    "@yaireo/tagify": "^4.35.4",
    "nuxt": "catalog:",
    "tailwindcss": "^4.1.12",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop-unit-testing": "^1.1.1",
    "@nuxt/test-utils": "catalog:",
    "@types/yaireo__tagify": "^4.27.0",
    "@vitest/browser": "^3.2.4",
    "@vue/compiler-dom": "^3.5.22",
    "@vue/server-renderer": "^3.5.21",
    "playwright": "^1.55.0",
    "ufo": "^1.6.1",
    "unimport": "^5.2.0",
    "unplugin-vue-router": "^0.16.0",
    "vite": "^7.1.4",
    "vitest": "catalog:",
    "vitest-browser-vue": "^1.1.0",
    "vitest-environment-nuxt": "^1.0.1",
    "vue-i18n": "^11.1.11"
  }
}
